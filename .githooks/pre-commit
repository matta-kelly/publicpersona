#!/usr/bin/env bash
# Runs lint + typecheck on staged TS/TSX changes before commit.
# Skip with: git commit --no-verify (don't make a habit of it).

set -e

if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(ts|tsx|js|jsx|mjs|cjs)$'; then
  exit 0
fi

# The packages live in a volume only the dev container mounts, so on the host there is nothing to run.
if [ ! -x node_modules/.bin/eslint ]; then
  echo "pre-commit: skipped on the host; lint and typecheck run in the dev container"
  exit 0
fi

echo "→ pnpm lint"
pnpm -s lint

echo "→ pnpm typecheck"
pnpm -s typecheck
