    "query": "query Activity($login: String!, $since: GitTimestamp!) {\n  user(login: $login) {\n    contributionsCollection {\n      contributionCalendar {\n        weeks {\n          contributionDays {\n            date\n            contributionCount\n          }\n        }\n      }\n    }\n    repositories(\n      first: 100\n      ownerAffiliations: OWNER\n      privacy: PUBLIC\n      isFork: false\n      isArchived: false\n      orderBy: { field: PUSHED_AT, direction: DESC }\n    ) {\n      nodes {\n        name\n        description\n        url\n        createdAt\n        languages(first: 100) {\n          edges {\n            size\n            node {\n              name\n            }\n          }\n        }\n        defaultBranchRef {\n          target {\n            ... on Commit {\n              history(since: $since) {\n                totalCount\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}",
