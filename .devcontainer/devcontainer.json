{
  "name": "publicpersona",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  // .next stores absolute paths, so the path inside has to match the host's.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  // Maps the host user onto the image's node user, so files written from inside stay owned by the host user.
  "runArgs": ["--userns=keep-id:uid=1000,gid=1000"],
  "remoteUser": "node",
  "updateRemoteUserUID": false,
  // The repo folder sits in an Obsidian vault that loads every file in it, so generated files live in volumes.
  "mounts": [
    "source=publicpersona-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=publicpersona-next,target=${containerWorkspaceFolder}/.next,type=volume",
    "source=publicpersona-pnpm-store,target=/home/node/.pnpm-store,type=volume"
  ],
  "containerEnv": {
    // Left to itself pnpm puts the store at the root of the project's filesystem, which is the repo folder.
    "npm_config_store_dir": "/home/node/.pnpm-store",
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  // A new volume starts owned by root. The image ships its own pnpm in npm-global, ahead of
  // /usr/local/bin on PATH, so corepack's shims go there to be the pnpm that runs.
  "postCreateCommand": "sudo chown node:node node_modules .next /home/node/.pnpm-store && corepack enable --install-directory /usr/local/share/npm-global/bin && pnpm install --frozen-lockfile"
}
